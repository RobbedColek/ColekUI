<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:ColekUI.Sample.Pages"
             x:Class="ColekUI.Sample.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel">
    <StackPanel Spacing="8" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="20" Margin="0,0,0,8" />
        <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedIndex="{Binding SelectedLanguage}" MinWidth="160" />
        <TextBlock Text="Dialog buttons and window-button tooltips use the selected language." Opacity="0.7" />
    </StackPanel>
</UserControl>
