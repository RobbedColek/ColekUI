<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#FF808080" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF161616" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF242424" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF555555" />
</ResourceDictionary>
