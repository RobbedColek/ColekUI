<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ColekUI/Theme/Palette.axaml" />
                <ResourceInclude Source="avares://ColekUI/Theme/WindowButtonIcons.axaml" />
                <ResourceInclude Source="avares://ColekUI/Theme/ColekWindow.axaml" />
                <ResourceInclude Source="avares://ColekUI/Theme/DialogWindow.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource ColekUI.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColekUI.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ColekUI.CaptionTextBrush}" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ColekUI.ErrorTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector=":is(TextBlock).dialog-message">
        <Setter Property="Foreground" Value="{DynamicResource ColekUI.SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.action">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</Styles>
